@book{carvachoProblemaEducacionChile2025,
  title = {{El problema de la educaci{\'o}n en Chile}},
  author = {Carvacho, Cristi{\'a}n Bellei},
  year = {2025},
  month = sep,
  publisher = {DEBATE},
  abstract = {Una mirada cr{\'i}tica, rigurosa y accesible al estancamiento de la educaci{\'o}n chilena, sus causas estructurales y las rutas posibles hacia una transformaci{\'o}n integral.   En El problema de la educaci{\'o}n chilena, Cristi{\'a}n Bellei realiza un diagn{\'o}stico profundo del sistema escolar en Chile, revelando por qu{\'e}, a pesar de m{\'u}ltiples reformas y una creciente inversi{\'o}n p{\'u}blica, la calidad educativa se ha estancado. El autor desarma el mito de que "no se ha hecho nada" y muestra que el verdadero problema radica en haber seguido un paradigma errado: uno que prioriza la competencia de mercado, la estandarizaci{\'o}n y la rendici{\'o}n de cuentas por sobre el aprendizaje significativo y equitativo. Desde la demolici{\'o}n del Estado Docente durante la dictadura, pasando por la expansi{\'o}n del sistema privado subvencionado, el debilitamiento sostenido de la educaci{\'o}n p{\'u}blica, hasta los l{\'i}mites del Simce como herramienta de mejora, Bellei articula una narrativa que combina evidencia emp{\'i}rica, experiencia de terreno y sensibilidad social. El libro identifica causas institucionales, pol{\'i}ticas y culturales del problema educacional, discute el rol de los liceos emblem{\'a}ticos, los profesores, las familias y los rankings, y expone los fracasos del modelo neoliberal. Pero tambi{\'e}n hay esperanza. En sus {\'u}ltimos cap{\'i}tulos, el autor muestra casos reales de escuelas que han logrado mejorar y plantea una propuesta concreta: reorientar el sistema hacia una educaci{\'o}n integral, colaborativa, pertinente al siglo XXI y centrada en el aprendizaje, no en la competencia. Con un estilo claro y sin tecnicismos, Bellei busca aportar a una conversaci{\'o}n p{\'u}blica urgente sobre qu{\'e} tipo de educaci{\'o}n necesita y merece Chile.},
  googlebooks = {m7x3EQAAQBAJ},
  isbn = {978-956-624-796-8},
  langid = {spanish},
  keywords = {Education / History}
}

